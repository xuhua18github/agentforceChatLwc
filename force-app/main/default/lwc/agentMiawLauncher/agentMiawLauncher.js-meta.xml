<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>60.0</apiVersion>
  <isExposed>true</isExposed>
  <masterLabel>Agent MAIW Launcher</masterLabel>
  <targets>
    <target>lightningCommunity__Default</target>
    <target>lightningCommunity__Page</target>
    <target>lightning__AppPage</target>
    <target>lightning__RecordPage</target>
    <target>lightning__HomePage</target>
  </targets>
  <targetConfigs>
    <!-- Properties supported on these targets -->
    <targetConfig targets="lightningCommunity__Default,lightning__AppPage,lightning__RecordPage,lightning__HomePage">
      <property name="buttonLabel" type="String" label="Button label" default="Contact support"/>
      <property name="orgUrl" type="String" label="Org URL (https://...my.salesforce.com)"/>
      <property name="siteUrl" type="String" label="Experience Cloud Site URL (https://...my.site.com)"/>
      <property name="salesforceOrgId" type="String" label="Salesforce Org Id (00D...)"/>
      <property name="deploymentName" type="String" label="Messaging Deployment Name"/>
      <property name="scrt2Url" type="String" label="SCRT2 URL (from Messaging setup)"/>
      <property name="identityTokenType" type="String" label="Identity token type (OAuth)" default="OAuth"/>
      <property name="preferApexAccessToken" type="Boolean" label="Fetch access token via Apex" default="true"/>
      <property name="accessTokenEndpoint" type="String" label="Access token HTTP endpoint (optional)"/>
      <property name="enableSearchMode" type="Boolean" label="Enable search mode (if supported)" default="false"/>
      <property name="disableUserInputForBot" type="Boolean" label="Disable user input when bot is active" default="false"/>
      <property name="prechatSubjectFieldApiName" type="String" label="Prechat subject field API name" default="_subject"/>
      <property name="prechatFirstNameApiName" type="String" label="Prechat first name field API name" default="_firstName"/>
      <property name="prechatLastNameApiName" type="String" label="Prechat last name field API name" default="_lastName"/>
      <property name="prechatEmailApiName" type="String" label="Prechat email field API name" default="_email"/>
      <property name="debug" type="Boolean" label="Enable debug logs in console" default="false"/>
      <property name="language" type="String" label="Language (e.g., en_US)" default="en_US"/>
      <property name="disableTargetElement" type="Boolean" label="Disable custom container (dock widget)" default="false"/>
    </targetConfig>
    <!-- Removed empty lightningCommunity__Page targetConfig to avoid validation error -->
  </targetConfigs>
</LightningComponentBundle>