<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>60.0</apiVersion>
  <isExposed>true</isExposed>
  <masterLabel>Agent MAIW Launcher</masterLabel>
  <targets>
    <target>lightningCommunity__Default</target>
    <target>lightningCommunity__Page</target>
    <target>lightning__AppPage</target>
    <target>lightning__RecordPage</target>
    <target>lightning__HomePage</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Default,lightningCommunity__Page,lightning__AppPage,lightning__RecordPage,lightning__HomePage">
      <property name="buttonLabel" type="String" label="Button label" default="Contact support"/>
      <property name="orgUrl" type="String" label="Org URL (https://...my.salesforce.com)"/>
      <property name="siteUrl" type="String" label="Experience Cloud Site URL (https://...my.site.com)"/>
      <property name="salesforceOrgId" type="String" label="Salesforce Org Id (00D...)"/>
      <property name="deploymentName" type="String" label="Messaging Deployment Name"/>
      <property name="scrt2Url" type="String" label="SCRT2 URL (from Messaging setup)"/>
      <property name="identityTokenType" type="String" label="Identity token type (OAuth)" default="OAuth"/>
      <property name="preferApexAccessToken" type="Boolean" label="Fetch access token via Apex" default="true"/>
      <property name="accessTokenEndpoint" type="String" label="Access token HTTP endpoint (optional)"/>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>